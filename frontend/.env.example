# Where the FastAPI backend is running
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Sign in with Microsoft (Azure portal → Microsoft Entra ID → App registrations → your app).
# Register a "Single-page application" redirect URI: http://localhost:3000/register
# Use the same client and tenant IDs in backend/.env (AZURE_CLIENT_ID / AZURE_TENANT_ID).
# Leave the client ID empty to use the developer sign-in (name + email) locally.
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=organizations
