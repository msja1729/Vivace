# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=dev

# SQLite (default, no setup). For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://viva:viva@localhost:5432/viva
DATABASE_URL=sqlite:///./viva.db

# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]

# Generate a long random value for anything beyond local dev:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=1440

# password = register / log in with email + password (and Microsoft, if configured). microsoft = Microsoft only.
# dev = also a password-less name + email sign-in, for automated tests only. Never use it on a public server.
AUTH_MODE=password

# Microsoft Entra ID (Azure portal → App registrations → your app → Overview)
# Sign in with Microsoft turns on when AZURE_CLIENT_ID is set. Use the same values in frontend/.env.local.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=organizations
# Only these email domains may sign in (JSON list). Empty = any work/school account.
ALLOWED_EMAIL_DOMAINS=[]

# Where uploaded files are stored, and the largest file accepted (MB)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Students must open a viva within this many minutes of its start time (their own slot, in staff-run vivas)
VIVA_JOIN_WINDOW_MINUTES=5

# ---------- Live vivas (needs: uv sync --extra live) ----------
# The AI grades answers and suggests questions to the examiner. Without a key, the live room still
# works (video, integrity flags, transcript) but shows "AI grading unavailable".
# LLM_PROVIDER: claude (paid, best grading) or gemini (free tier at aistudio.google.com).
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium
GEMINI_API_KEY=
# gemini-flash-latest follows Google's newest Flash model; or pin an ID from aistudio.google.com
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the main model is busy (503) or out of free quota (429)
GEMINI_FALLBACK_MODELS=["gemini-2.5-flash"]
# Check the key and model:  uv run python -m scripts.check_llm
# faster-whisper model: tiny.en (fastest) · base.en · small.en (more accurate) · medium.en
WHISPER_MODEL=base.en
# auto = GPU if PyTorch sees one. For CUDA, install the CUDA build of torch.
ML_DEVICE=auto
# Detector thresholds and score weights
LIVE_CONFIG_FILE=./config.yaml
# Delete integrity snapshots this many days after the session (0 = keep)
SNAPSHOT_RETENTION_DAYS=30
